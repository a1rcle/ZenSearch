export global Theme {
    in property <color> background: #1E1F29;
    in property <color> surface: #282A36;
    in property <color> surface-hover: #343746;
    in property <color> surface-selected: #44475A;
    in property <color> border: #3E4256;
    in property <color> primary: #7AA2F7;
    in property <color> text: #F8F8F2;
    in property <color> text-muted: #8E95B3;
    in property <color> accent: #50FA7B;
    in property <length> border-radius: 12px;
}
